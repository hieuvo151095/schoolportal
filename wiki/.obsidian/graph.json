    { "query": "path:pages/screens",  "color": { "a": 1, "rgb": 3381759 } },
    { "query": "path:pages/entities", "color": { "a": 1, "rgb": 5025616 } },
    { "query": "path:pages/concepts", "color": { "a": 1, "rgb": 10233776 } },
    { "query": "path:pages/sources",  "color": { "a": 1, "rgb": 10395294 } },
    { "query": "path:raw",            "color": { "a": 1, "rgb": 12434877 } },
